# Copy this file to .env.local and fill in local secrets.
# .env.local is ignored by git and loaded by scripts/start-*.sh.

SPRING_PROFILE='prepared-local'
PREPARED_BACKEND_PORT='13014'
PREPARED_FRONTEND_PORT='13015'
JAVA_HOME=''
AUTH_COOKIE_SECURE='false'

PREPARED_DASHSCOPE_API_KEY=''
DASHSCOPE_ENABLE_THINKING='false'
DASHSCOPE_REALTIME_ENABLED='false'
DASHSCOPE_REALTIME_URL='wss://dashscope.aliyuncs.com/api-ws/v1/realtime'
DASHSCOPE_REALTIME_MODEL='qwen3.5-omni-flash-realtime'
DASHSCOPE_REALTIME_VOICE='Ethan'
DASHSCOPE_REALTIME_TRANSCRIPT_WAIT_MS='5000'
DASHSCOPE_REALTIME_RESPONSE_WAIT_MS='20000'
DASHSCOPE_REALTIME_VOICE_OUTPUT_ENABLED='false'
DASHSCOPE_REALTIME_VOICE_OUTPUT_WAIT_MS='12000'
# Reject abnormal upstream events before they can exhaust application memory.
DASHSCOPE_REALTIME_MAX_EVENT_CHARS='1048576'
DASHSCOPE_REALTIME_MAX_TRANSCRIPT_CHARS='20000'
DASHSCOPE_REALTIME_MAX_RESPONSE_AUDIO_BYTES='16777216'
FILE_DOWNLOAD_MAX_BYTES='73400320'

PREPARED_DB_JDBC_URL='jdbc:mysql://127.0.0.1:13317/prepared_interview?useUnicode=true&characterEncoding=UTF-8&sslMode=REQUIRED&serverTimezone=Asia/Shanghai'
PREPARED_DB_USERNAME=''
PREPARED_DB_PASSWORD=''
# Fresh local installation: scripts/init-local-mysql.sh refuses existing data.
# Requires Java 21, an explicit canonical PREPARED_MYSQL_BASEDIR and an independent
# 32-128 character application password using letters/numbers/+/_/=/-. No demo secret.
# Administrator and migration credentials are generated into owner-only .runtime
# files, not added here or inherited by the application. This is initialization,
# not reset/credential rotation. Set JAVA_HOME to a Java 21 JDK, start the owned
# local database, then run scripts/migrate-local-mysql.sh before runtime startup.
# Migration builds with no database/model credentials and reads only the separate
# private migration option file. It never adopts an existing unmarked server.
# scripts/start-local-mysql.sh only starts an already initialized NEW directory.
# Set the installed MySQL binary directory if it differs from ~/.local/mysql-8.4.3.
PREPARED_MYSQL_BASEDIR=''
PREPARED_MYSQL_PORT='13317'

DB_TUNNEL_ENABLED='false'
DB_TUNNEL_WATCH='true'
DB_TUNNEL_CHECK_INTERVAL='5'
DB_TUNNEL_LOCAL_HOST='127.0.0.1'
DB_TUNNEL_LOCAL_PORT='13307'
DB_TUNNEL_REMOTE_HOST='127.0.0.1'
DB_TUNNEL_REMOTE_PORT='3306'
DB_TUNNEL_SSH_HOST=''
DB_TUNNEL_SSH_USER=''
DB_TUNNEL_SSH_KEY=''
DB_TUNNEL_SSH_PASSWORD=''

PREPARED_REDIS_HOST='127.0.0.1'
PREPARED_REDIS_PORT='16389'
PREPARED_REDIS_PASSWORD=''

PREPARED_OSS_ENDPOINT=''
PREPARED_OSS_ACCESS_KEY_ID=''
PREPARED_OSS_ACCESS_KEY_SECRET=''
PREPARED_OSS_BUCKET='prepared-interview-local'

# Disabled until independent credentials, pricing and per-call cost caps are verified.
PREPARED_MODELS_ENABLED='false'
PREPARED_MODEL_TEST_BUDGET_CNY='100'
PREPARED_MODEL_TEST_PAUSE_CNY='80'

# AI preparation stays disabled until the independent account and conservative current price evidence are verified.
# Use worst-tier CNY rates per million billed tokens, including any reasoning tokens; not guessed max_tokens charges.
PREPARED_GENERATION_WORKER_ENABLED='false'
PREPARED_GENERATION_ENDPOINT='https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions'
PREPARED_GENERATION_BILLING_REFERENCE=''
PREPARED_GENERATION_PRICING_REFERENCE=''
PREPARED_GENERATION_PRICING_VERIFIED_AT=''
PREPARED_GENERATION_MAX_BILLED_INPUT_TOKENS=''
PREPARED_GENERATION_MAX_BILLED_OUTPUT_TOKENS=''
PREPARED_GENERATION_INPUT_PRICE_CNY=''
PREPARED_GENERATION_OUTPUT_PRICE_CNY=''

# Prepared TTS uses native character billing, not chat token prices. No guessed price defaults.
# Shares the same CNY 100/80 ledger with generation, ASR and scoring.
PREPARED_TTS_WORKER_ENABLED='false'
# Non-paid whole-question composition; keep disabled until independent private storage is verified.
PREPARED_AUDIO_ASSEMBLY_ENABLED='false'
PREPARED_TTS_API_KEY=''
PREPARED_TTS_BILLING_REFERENCE=''
PREPARED_TTS_PRICING_REFERENCE=''
PREPARED_TTS_PRICING_VERIFIED_AT=''
PREPARED_TTS_MAX_BILLED_CHARACTERS=''
PREPARED_TTS_PRICE_CNY=''
# Absolute canonical path ending in prepared-tts-spool; POSIX owner-only permissions required.
PREPARED_TTS_SPOOL_ROOT=''

# Separate private audio adapter; do not reuse old service credentials or bucket.
# Bucket must remain private, without public policy and never version-enabled/suspended.
PREPARED_PRIVATE_STORAGE_ENABLED='false'
PREPARED_PRIVATE_STORAGE_ENDPOINT='https://oss-cn-beijing.aliyuncs.com'
PREPARED_PRIVATE_STORAGE_BUCKET=''
PREPARED_PRIVATE_STORAGE_ACCESS_KEY_ID=''
PREPARED_PRIVATE_STORAGE_ACCESS_KEY_SECRET=''

# Separate non-paid student whole-answer verification; independent from teacher TTS/assembly.
# Keep disabled until real private upload/readback, device QA and submission integration pass.
PREPARED_ANSWER_MEDIA_WORKER_ENABLED='false'
# Absolute resolved executable paths (not symlinks), ending in ffmpeg / ffprobe.
PREPARED_ANSWER_MEDIA_FFMPEG=''
PREPARED_ANSWER_MEDIA_FFPROBE=''
# Absolute canonical path ending in prepared-answer-spool; POSIX owner-only permissions required.
PREPARED_ANSWER_MEDIA_SPOOL_ROOT=''

# Privacy and retention. ISO-8601 durations: P30D means 30 days.
DATA_RETENTION_ENABLED='false'
TOKEN_AUDIT_RETENTION='P30D'
INTERVIEW_MEDIA_RETENTION='P180D'
DELETED_ASSESSMENT_MATERIAL_RETENTION='P30D'
BUSINESS_RECORD_RETENTION='P730D'
# Destructive long-term result deletion is opt-in.
PURGE_BUSINESS_RECORDS='false'
RETENTION_CLEANUP_BATCH_SIZE='100'
RETENTION_MAX_BATCHES_PER_RUN='10'
RETENTION_CLEANUP_CRON='0 30 3 * * ?'

LOG_MAX_FILE_SIZE='50MB'
LOG_MAX_HISTORY_DAYS='14'
LOG_TOTAL_SIZE_CAP='1GB'
